  "version": "0.1.0",
  "description": "Realistic three.js night-sky viewer: Perseid meteor shower over Mount Rainier or Joshua Tree with a real star map, Milky Way, lake reflections and constellations.",
  "homepage": "https://paulpowang.github.io/meteor-night/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulpowang/meteor-night.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-stars.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
